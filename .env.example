# Copia este archivo como .env y cambia los valores.

# Contraseña de la base de datos PostgreSQL
DB_PASSWORD=una-clave-segura-aqui

# Secreto para firmar los tokens de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-algo-muy-largo-y-aleatorio

# Usuario administrador inicial (se crea la primera vez que arranca)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia-esta-clave

# Contraseña inicial de los usuarios de demostración (Ana, Luis, María)
DEMO_PASSWORD=ordengo123

# Tarifa por hora que se asigna por defecto a las órdenes creadas por un técnico
# (los técnicos nunca definen precios; Gerencia los ajusta después). 0 = sin tarifa.
DEFAULT_RATE=0

# Clave de la API de Anthropic para la función de IA en fotos (opcional).
# Si la dejas vacía, la app funciona igual pero sin autocompletado por IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Si usas docker-compose, no necesitas tocar DATABASE_URL (se arma solo).
# Para desplegar la app SOLA contra una base externa (p. ej. EasyPanel), define:
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
