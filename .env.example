# Copia este archivo como .env y cambia los valores.

# Contraseña de la base de datos PostgreSQL
DB_PASSWORD=una-clave-segura-aqui

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres, largo y aleatorio)
JWT_SECRET=cambia-esto-por-algo-muy-largo-y-aleatorio

# Orígenes autorizados si frontend y API se publican en dominios distintos.
# Para varios, sepáralos por coma. En despliegues del mismo dominio puede quedar vacío.
CORS_ORIGIN=

# Usuario administrador inicial (se crea la primera vez que arranca).
# Si dejás ADMIN_PASSWORD vacío, el servidor genera una contraseña temporal al azar y la
# imprime una única vez en su log de arranque (forzando su cambio en el primer ingreso).
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia-esta-clave

# Cuenta de solo visualización para el televisor o monitor de oficina.
# Mismo comportamiento que ADMIN_PASSWORD si se deja vacío.
MONITOR_EMAIL=monitor.oficina@empresa.com
MONITOR_PASSWORD=

# Tarifa por hora que se asigna por defecto a las órdenes creadas por un técnico
# (los técnicos nunca definen precios; Administración los ajusta después).
DEFAULT_RATE=50

# Si usas docker-compose, no necesitas tocar DATABASE_URL (se arma solo).
# Para desplegar la app SOLA contra una base externa (p. ej. EasyPanel), define:
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
